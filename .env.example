# ---------------------------------------------------------------------------
# ندوات — environment
# Copy to .env.local for development. Set the same keys in the Vercel project.
# The site builds and runs without any of these (demo mode with fixture data);
# real data, auth and email require them.
# ---------------------------------------------------------------------------

# Canonical origin. Local: http://localhost:3000 — Production: https://nadawat.org
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase -------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Project Settings → API → service_role (SECRET — server only, never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend --------------------------------------------------------------
# resend.com → API Keys. Sending only — the mailbox itself is hosted elsewhere.
RESEND_API_KEY=""
# Sender identity. events@nadawat.org must be a verified domain/sender in Resend.
EMAIL_FROM="ندوات <events@nadawat.org>"
# Reply-To: an externally hosted, monitored inbox. Never a noreply address.
EMAIL_REPLY_TO="events@nadawat.org"

# --- Misc --------------------------------------------------------------
# Random string. Salts the hash of IP addresses stored with consent records.
CONSENT_IP_SALT="change-me-to-a-long-random-string"

# --- Optional --------------------------------------------------------
# Logo is real vector, inlined from src/components/ui/logo-mark.tsx and
# recoloured via CSS — no env var needed. These only apply if the mark is
# ever replaced with an external image asset instead (light / dark variants):
# NEXT_PUBLIC_LOGO_URL="/brand/nadawat-logo.png"
# NEXT_PUBLIC_LOGO_URL_CREAM="/brand/nadawat-logo-cream.png"
